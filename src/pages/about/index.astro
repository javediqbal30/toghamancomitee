---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout
  title="About Us | Togh Aman Committee"
  description="Learn about the origin, constitution, leadership, and democratic structure of the Togh Aman Committee serving Togh Bala & Payan."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container text-center">
      <Badge variant="gold">Origins & Governance</Badge>
      <h1 class="page-title">About the Togh Aman Committee</h1>
      <p class="page-subtitle">
        A lawful, non-political, non-sectarian civic trust created by and for the people of Togh Bala & Payan.
      </p>
    </div>
  </section>

  <!-- Preamble & Sacred Principle -->
  <section class="section">
    <div class="container">
      <div class="card card-gold-accent preamble-card reveal-on-scroll">
        <span class="section-tag">Constitutional Preamble</span>
        <h2>The Foundation of Our Trust</h2>
        <p class="lead-text">
          "The Togh Public Committee will be a non-political, non-sectarian public welfare platform. 
          The Committee will not be used for the personal benefit of any person, family, or group. 
          The common good of the whole area will always come first."
        </p>
        <div class="principle-quote-box">
          <Icon name="balance" size={28} class="text-gold" />
          <blockquote>
            "The Togh Public Committee is not the property of any person. It is a trust of the people."
          </blockquote>
        </div>
        <p>
          All office holders and members of this Committee are not owners of power. 
          They are representatives who are answerable to the people under the rule of law, merit, joint consultation, written proof, and public interest.
        </p>
      </div>
    </div>
  </section>

  <!-- Historical Timeline -->
  <section class="section timeline-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="green">Our Journey</Badge>
        <h2>Historical Milestones</h2>
        <p class="section-subtitle">
          How community consultation transformed into an institutional, constitution-bound committee.
        </p>
      </div>

      <div class="timeline-container">
        <!-- Milestone 1 -->
        <div class="timeline-item reveal-on-scroll">
          <div class="timeline-marker"></div>
          <div class="timeline-card card">
            <span class="timeline-date">July 2024</span>
            <h3>Foundation Laid</h3>
            <p>
              Founder <strong>Hadayatullah Khan</strong> initiated the peaceful public movement in Togh, uniting respected village elders to build a lawful platform protecting public rights and settling communal disputes.
            </p>
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="timeline-item reveal-on-scroll delay-1">
          <div class="timeline-marker"></div>
          <div class="timeline-card card">
            <span class="timeline-date">July 2026</span>
            <h3>Strengthened & Constitution Codified</h3>
            <p>
              The movement was formalized into an institutional framework with an 18-chapter Constitution, written rules of procedure, financial transparency protocols, and separation of administrative powers.
            </p>
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="timeline-item reveal-on-scroll delay-2">
          <div class="timeline-marker"></div>
          <div class="timeline-card card card-gold-accent">
            <span class="timeline-date">25 August 2026</span>
            <h3>Formal Public Opening</h3>
            <p>
              Formal inauguration of the committee secretariat under the presidency of <strong>Malik Ihsanullah</strong>, declaring zero tolerance against narcotics, crime, and land encroachment within the bounds of Pakistani law.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Detailed Section -->
  <section class="section leadership-full-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="gold">Executive Governance</Badge>
        <h2>Custodian Leadership</h2>
        <p class="section-subtitle">
          Guided by merit and joint consultation rather than unilateral decisions.
        </p>
      </div>

      <div class="leaders-profile-grid">
        <!-- Founder Profile -->
        <div class="card leader-profile reveal-on-scroll">
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/hadayatullah-khan.webp" 
              alt="Hadayatullah Khan - Founder" 
              class="profile-img"
              loading="lazy"
            />
          </div>
          <div class="profile-content">
            <Badge variant="gold">Founder & Visionary</Badge>
            <h3>Hadayatullah Khan</h3>
            <span class="profile-tenure">Foundation: July 2024 &bull; Revival: July 2026</span>
            <p>
              "The strength of Togh lies in its people, our shared heritage, and our unyielding moral fabric. 
              The Committee exists to ensure our youth have jobs and sports rather than narcotics, our shared lands remain unviolated, 
              and our grievances are heard respectfully by state institutions."
            </p>
          </div>
        </div>

        <!-- President Profile -->
        <div class="card leader-profile reveal-on-scroll delay-1">
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/malik-ihsanullah.webp" 
              alt="Malik Ihsanullah - President" 
              class="profile-img"
              loading="lazy"
            />
          </div>
          <div class="profile-content">
            <Badge variant="green">President</Badge>
            <h3>Malik Ihsanullah</h3>
            <span class="profile-tenure">Inaugural Term &bull; Formally Opened: 25 August 2026</span>
            <p>
              "Under Chapter 5 of our constitution, the President does not hold the power to make vital decisions alone. 
              Every action must be sanctioned by written resolution. Our primary battle is ridding Togh of narcotics (ice) 
              and illegal scrap yards, standing firmly with the police and law."
            </p>
          </div>
        </div>

        <!-- In-Charge Complaints Cell Profile -->
        <div class="card leader-profile reveal-on-scroll delay-2">
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/Mr_Shafiq_ur_Rehman.webp" 
              alt="Mr. Shafiq-ur-Rehman - In-Charge Complaints Cell" 
              class="profile-img"
              loading="lazy"
            />
          </div>
          <div class="profile-content">
            <Badge variant="gold">In-Charge Complaints Cell</Badge>
            <h3>Mr. Shafiq-ur-Rehman</h3>
            <span class="profile-tenure">Grievance & Citizen Cell &bull; Direct: 0333-8303485</span>
            <p>
              "The Toogh Aman Committee informs all community elders, leaders, senior members, and respected scholars that our Complaints Cell is actively listening to community concerns. If any individual faces an issue, particularly concerning any member of the Aman Committee, they are requested to contact me directly. All complaints will be heard respectfully and reviewed appropriately."
            </p>
            <div class="profile-contact-actions">
              <a href="tel:03338303485" class="profile-chip-btn">
                <Icon name="phone" size={13} />
                <span>0333-8303485</span>
              </a>
              <a href="https://wa.me/923338303485?text=Peace%20be%20upon%20you%20Mr.%20Shafiq-ur-Rehman,%20I%20have%20a%20grievance%20for%20the%20Complaints%20Cell." target="_blank" rel="noopener noreferrer" class="profile-chip-btn profile-wa-btn">
                <Icon name="whatsapp" size={13} />
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Finance Secretary Profile -->
        <div class="card leader-profile reveal-on-scroll delay-3">
          <div class="leader-photo-wrap">
            <img 
              src="/assets/leaders/Waheed_ur_Rehman.webp" 
              alt="Waheed-ur-Rehman - Finance Secretary" 
              class="profile-img"
              loading="lazy"
            />
          </div>
          <div class="profile-content">
            <Badge variant="green">Finance Secretary</Badge>
            <h3>Waheed-ur-Rehman</h3>
            <span class="profile-tenure">Treasury Custodian &bull; Easypaisa: 0334 8441095</span>
            <p>
              "In accordance with Chapter 8 of the Togh Aman Constitution, our financial management is bound to absolute public accountability. No funds are accepted without official numbered receipts, and all expenditures require prior quorum-approved resolutions."
            </p>
            <div class="profile-easypaisa-box">
              <span class="ep-box-label">Official Easypaisa Account:</span>
              <strong class="ep-box-num">0334 8441095</strong>
            </div>
            <div class="profile-contact-actions">
              <a href="tel:03348441095" class="profile-chip-btn">
                <Icon name="phone" size={13} />
                <span>0334 8441095</span>
              </a>
              <a href="https://wa.me/923348441095?text=Peace%20be%20upon%20you%20Waheed-ur-Rehman%20Sahib,%20I%20am%20contacting%20regarding%20Togh%20Aman%20Committee%20finance." target="_blank" rel="noopener noreferrer" class="profile-chip-btn profile-wa-btn">
                <Icon name="whatsapp" size={13} />
                <span>WhatsApp Desk</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Democratic Structure -->
  <section class="section structure-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="green">Institutional Framework</Badge>
        <h2>Committee Structure</h2>
        <p class="section-subtitle">
          A multi-tiered structure designed for checks, balances, and community-wide representation.
        </p>
      </div>

      <div class="structure-grid">
        <div class="card structure-card reveal-on-scroll">
          <Icon name="balance" size={28} class="text-green mb-3" />
          <h4>Advisors & Legal Council</h4>
          <p>Qualified legal advisors reviewing resolutions, land issues, and institutional correspondence to guarantee complete legal compliance.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-1">
          <Icon name="shield" size={28} class="text-green mb-3" />
          <h4>Executive Committee</h4>
          <p>Comprising the President, General Secretary, Finance Secretary, and Joint Secretaries responsible for day-to-day operations and projects.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-2">
          <Icon name="document" size={28} class="text-green mb-3" />
          <h4>Ulama (Religious Scholars)</h4>
          <p>Respected scholars reviewing all community decisions and resolutions from the viewpoint of Shariah and moral integrity.</p>
        </div>

        <div class="card structure-card reveal-on-scroll">
          <Icon name="users" size={28} class="text-green mb-3" />
          <h4>Women's Wing</h4>
          <p>A dedicated, self-governing wing safeguarding the social, educational, and welfare rights of women and children in private trust.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-1">
          <Icon name="users" size={28} class="text-green mb-3" />
          <h4>Youth & Overseas Affairs</h4>
          <p>Dedicated wings promoting sports tournaments, employment skills, and coordinating transparent support from overseas members.</p>
        </div>

        <div class="card structure-card reveal-on-scroll delay-2">
          <Icon name="balance" size={28} class="text-green mb-3" />
          <h4>The General Body</h4>
          <p>The supreme forum of the people with authority to approve policy, review yearly accounts, and elect or dissolve the cabinet.</p>
        </div>
      </div>

      <div class="text-center mt-12 reveal-on-scroll">
        <Button variant="primary" size="lg" href="/transparency/constitution">
          <span>Read Full Constitution & Rules</span>
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-background) 100%);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
  }

  .section-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    display: block;
    margin-bottom: var(--space-2);
  }

  .lead-text {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: var(--space-6);
  }

  .principle-quote-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    background: var(--color-surface-subtle);
    border-left: 4px solid var(--color-gold);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }

  .principle-quote-box blockquote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-primary);
    line-height: var(--leading-snug);
  }

  /* Timeline */
  .timeline-container {
    position: relative;
    max-width: 760px;
    margin: var(--space-8) auto 0;
    padding-left: var(--space-8);
    border-left: 3px solid var(--color-gold);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-8);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-8) - 9px);
    top: 24px;
    width: 16px;
    height: 16px;
    background-color: var(--color-white);
    border: 4px solid var(--color-gold);
    border-radius: var(--radius-full);
  }

  .timeline-date {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-green);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-1);
  }

  /* Leadership */
  .leaders-profile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .leaders-profile-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .leaders-profile-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .profile-easypaisa-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #EBF8EE;
    border: 1px solid rgba(37, 211, 102, 0.4);
    border-radius: var(--radius-sm);
    padding: 5px 8px;
    margin-top: var(--space-3);
    font-size: 11.5px;
  }

  .ep-box-label {
    color: #1B5E20;
    font-weight: 600;
  }

  .ep-box-num {
    color: #064D32;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .profile-contact-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .profile-chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    background: #F4F8F5;
    color: var(--color-primary);
    border: 1px solid rgba(6, 77, 50, 0.15);
    transition: all var(--duration-fast);
  }

  .profile-chip-btn:hover {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .profile-wa-btn {
    background: #E8F5E9;
    color: #1B5E20;
    border-color: rgba(37, 211, 102, 0.4);
  }

  .profile-wa-btn:hover {
    background: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  .leader-photo-wrap {
    height: 320px;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-4);
    background-color: var(--color-surface-subtle);
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .profile-content h3 {
    margin-top: var(--space-2);
    margin-bottom: 2px;
  }

  .profile-tenure {
    font-size: var(--text-xs);
    color: var(--color-green);
    font-weight: 600;
    margin-bottom: var(--space-3);
    display: block;
  }

  .profile-content p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    line-height: var(--leading-normal);
  }

  /* Structure */
  .structure-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .structure-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .structure-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .structure-card h4 {
    color: var(--color-primary);
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
  }

  .structure-card p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin-bottom: 0;
  }

  .text-center { text-align: center; }
  .text-gold { color: var(--color-gold); }
  .text-green { color: var(--color-green); }
  .mb-3 { margin-bottom: var(--space-3); }
  .mt-12 { margin-top: var(--space-12); }
</style>
