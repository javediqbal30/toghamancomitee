---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Icon from '../components/ui/Icon.astro';
import PillarCard from '../components/blocks/PillarCard.astro';
import NewsCard from '../components/blocks/NewsCard.astro';
import StatCounter from '../components/blocks/StatCounter.astro';

// Fetch collection items
const allNews = await getCollection('news');
const latestNews = allNews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const allPillars = await getCollection('pillars');
const featuredPillars = allPillars.sort((a, b) => a.data.number - b.data.number).slice(0, 6);
---

<BaseLayout
  title="Togh Aman Committee | Peace & Welfare"
  description="Official portal of Togh Aman Committee. Dedicated to peace, transparent development, crime prevention, and community welfare in Togh Bala & Payan, Kohat."
>
  <!-- 1. Hero Section -->
  <section class="hero-section" id="hero-section">
    <!-- Interactive Ambient Glow & Dotted Matrix Layer -->
    <div class="hero-ambient-glow" id="hero-ambient-glow" aria-hidden="true"></div>
    <div class="hero-grid-pattern" aria-hidden="true"></div>

    <!-- Mountain Ridge Silhouette Horizon -->
    <div class="hero-mountain-backdrop" aria-hidden="true">
      <svg viewBox="0 0 1440 220" fill="none" preserveAspectRatio="none" class="mountain-svg">
        <path d="M0,220 L0,150 Q180,80 360,130 Q540,180 720,100 Q900,20 1080,110 Q1260,200 1440,140 L1440,220 Z" fill="rgba(8, 116, 67, 0.04)" />
        <path d="M0,220 L0,175 Q240,115 480,155 Q720,195 960,125 Q1200,55 1440,165 L1440,220 Z" fill="rgba(6, 77, 50, 0.07)" />
      </svg>
    </div>

    <div class="container hero-container-grid">
      <!-- Left Column: Core Authority & Punchy Action -->
      <div class="hero-content-col">
        <!-- Live Status Pill with Pulsing Beacon -->
        <div class="hero-live-pill reveal-on-scroll">
          <span class="live-beacon">
            <span class="beacon-dot"></span>
            <span class="beacon-ring"></span>
          </span>
          <span class="pill-text">Constitutional Public Trust &bull; Togh Bala &amp; Payan</span>
        </div>

        <!-- Monumental Headline with Golden Accent -->
        <h1 class="hero-main-title reveal-on-scroll delay-1">
          A Sacred <span class="gold-accent-word">Trust</span><br />
          of the People
        </h1>

        <!-- Constitutional Quote Card -->
        <div class="hero-quote-box reveal-on-scroll delay-2">
          <span class="quote-bar"></span>
          <blockquote class="hero-quote">
            "The Committee is not the property of any person. It is a trust of the people."
          </blockquote>
        </div>

        <!-- Concise, Impactful Mission Paragraph -->
        <p class="hero-lead-text reveal-on-scroll delay-3">
          Dedicated to lawful peace, eradicating narcotics, youth empowerment, 100% audited public funds, and safeguarding shared communal lands (Shamilat) across <strong>Togh Bala &amp; Payan</strong>, Kohat.
        </p>

        <!-- Action Buttons with Enhanced Styling -->
        <div class="hero-actions-group reveal-on-scroll delay-4">
          <Button variant="accent" size="lg" href="/complaints" class="hero-btn-primary pulse-gold">
            <Icon name="alert" size={20} />
            <span>Report an Issue (Private)</span>
          </Button>
          <Button variant="outline" size="lg" href="/our-work" class="hero-btn-secondary">
            <span>Explore 14 Pillars</span>
            <Icon name="arrow-right" size={18} />
          </Button>
        </div>

        <!-- Instant Trust Pillars Row -->
        <div class="hero-trust-row reveal-on-scroll delay-4">
          <div class="trust-pill">
            <Icon name="check-circle" size={15} class="text-green" />
            <span>Zero Retaliation</span>
          </div>
          <div class="trust-pill">
            <Icon name="shield" size={15} class="text-green" />
            <span>EXIF-Stripped Intake</span>
          </div>
          <div class="trust-pill">
            <Icon name="balance" size={15} class="text-green" />
            <span>100% Audited Treasury</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 3D Showcase & Floating Micro-Cards -->
      <div class="hero-visual-col reveal-on-scroll delay-2">
        <div class="interactive-emblem-card" id="interactive-card">
          <!-- Golden Ambient Halo Background -->
          <div class="emblem-halo"></div>

          <!-- Central Emblem Presentation Box -->
          <div class="emblem-inner-box">
            <div class="emblem-wrapper">
              <img 
                src="/assets/brand/togh-aman-committee-emblem.png" 
                alt="Official Emblem of Togh Aman Committee" 
                width="170" 
                height="170" 
                class="hero-emblem-img"
                loading="eager"
              />
              <div class="dove-glide-wrapper" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" class="gliding-dove-svg">
                  <path d="M12 4c-3 0-5 2-6 5-3 1-4 3-4 5 0 3 2 5 6 5h9c3 0 4-2 4-5 0-3-2-5-5-5-1-3-2-5-4-5z" />
                  <path d="M14 9c.5.5 1 1.5 1 2.5" />
                  <path d="M9 14l2-2" />
                </svg>
              </div>
            </div>
            
            <h2 class="emblem-card-title">Togh Aman Committee</h2>
            <span class="emblem-card-sub" dir="rtl">توغ امن کمیٹی کوہاٹ</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Live Announcement Ticker -->
  <div class="ticker-bar" aria-label="Official Announcements Ticker">
    <div class="container ticker-container">
      <div class="ticker-label">
        <Icon name="document" size={16} />
        <span>LATEST:</span>
      </div>
      <div class="ticker-viewport">
        <div class="ticker-track">
          <span class="ticker-item">Alhamdulillah! Formal Opening of Togh Aman Committee held on 25 August 2026.</span>
          <span class="ticker-item">&bull;</span>
          <span class="ticker-item">Official Secretariat Hotlines & WhatsApp: +92 333 9768022 &bull; +92 333 9636226 &bull; +92 336 9498887.</span>
          <span class="ticker-item">&bull;</span>
          <span class="ticker-item">Confidential Whistleblower Intake Pipeline Active with Automated EXIF Privacy Shield.</span>
          <span class="ticker-item">&bull;</span>
          <span class="ticker-item">Constitution & Rules of Procedure published in full transparency.</span>
          <span class="ticker-item">&bull;</span>
          <span class="ticker-item">Secretariat: Haji Rafiullah Khan Marhoom Market, Main Pindi Road, Kohat.</span>
          <span class="ticker-item">&bull;</span>
          <span class="ticker-item">Official Hotlines: +92 333 9768022 | +92 333 9636226 | +92 336 9498887.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Principle & Trust Matrix (5-Second Trust Test) -->
  <section class="trust-strip">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item reveal-on-scroll">
          <div class="trust-icon-box">
            <Icon name="balance" size={24} />
          </div>
          <div class="trust-content">
            <h4>Rule of Law & Merit</h4>
            <p>We work in strict cooperation with state institutions and police. Zero violence, zero illegal vigilantism.</p>
          </div>
        </div>

        <div class="trust-item reveal-on-scroll delay-1">
          <div class="trust-icon-box">
            <Icon name="document" size={24} />
          </div>
          <div class="trust-content">
            <h4>Documented Decisions</h4>
            <p>Every decision is codified in a numbered written resolution. Verbal decisions have zero legal standing.</p>
          </div>
        </div>

        <div class="trust-item reveal-on-scroll delay-2">
          <div class="trust-icon-box">
            <Icon name="shield" size={24} />
          </div>
          <div class="trust-content">
            <h4>Financial Integrity</h4>
            <p>Compulsory numbered receipts for every donation, expense vouchers, and audited public accounts.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Key Metrics & Stat Counters -->
  <section class="section metrics-section">
    <div class="container">
      <div class="stats-grid">
        <StatCounter value="14" label="Manifesto Pillars" sublabel="Comprehensive community charter" />
        <StatCounter value="2" label="Villages Unified" sublabel="Togh Bala & Togh Payan" />
        <StatCounter value="100%" label="Documented Ledger" sublabel="Numbered receipts & vouchers" />
        <StatCounter value="3 Lines" label="Public Hotlines" sublabel="+92 333 9768022 & WhatsApp" />
      </div>
    </div>
  </section>

  <!-- 5. Featured 14 Pillars Snapshot -->
  <section class="section pillars-snapshot-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="green">Our Constitutional Mandate</Badge>
        <h2>Our Work: 14 Manifesto Pillars</h2>
        <p class="section-subtitle">
          From anti-drugs action to common land protection, our work is bounded by written constitutional articles.
        </p>
      </div>

      <div class="pillars-grid">
        {featuredPillars.map((p) => (
          <PillarCard
            number={p.data.number}
            title={p.data.title}
            summary={p.data.summary}
            icon={p.data.icon}
            articleRef={p.data.articleRef}
          />
        ))}
      </div>

      <div class="text-center mt-10 reveal-on-scroll">
        <Button variant="primary" size="md" href="/our-work">
          <span>View All 14 Manifesto Pillars</span>
          <Icon name="arrow-right" size={16} />
        </Button>
      </div>
    </div>
  </section>

  <!-- 6. Executive Leadership Section -->
  <section class="section leadership-section">
    <div class="container">
      <div class="section-title-wrap text-center reveal-on-scroll">
        <Badge variant="gold">Leadership & Governance</Badge>
        <h2>Custodian Leadership</h2>
        <p class="section-subtitle">
          "All office holders and members are not owners of power. They are representatives answerable to the people."
        </p>
      </div>

      <div class="leaders-showcase-grid">
        <!-- Founder Card -->
        <div class="card leader-card reveal-on-scroll">
          <div class="leader-image-box">
            <img 
              src="/assets/leaders/hadayatullah-khan.webp" 
              alt="Hadayatullah Khan - Founder of Togh Aman Committee" 
              class="leader-img"
              width="400"
              height="360"
              loading="lazy"
            />
          </div>
          <div class="leader-details">
            <Badge variant="gold">Founder</Badge>
            <h3 class="leader-name">Hadayatullah Khan</h3>
            <span class="leader-meta">Foundation Laid: July 2024 &bull; Strengthened: July 2026</span>
            <p class="leader-bio">
              "Our homeland possesses historic dignity and peace. The committee was conceived to ensure that no individual's personal ambitions override the collective welfare, justice, and safety of our people."
            </p>
          </div>
        </div>

        <!-- President Card -->
        <div class="card leader-card reveal-on-scroll delay-1">
          <div class="leader-image-box">
            <img 
              src="/assets/leaders/malik-ihsanullah.webp" 
              alt="Malik Ihsanullah - President of Togh Aman Committee" 
              class="leader-img"
              width="400"
              height="360"
              loading="lazy"
            />
          </div>
          <div class="leader-details">
            <Badge variant="green">President</Badge>
            <h3 class="leader-name">Malik Ihsanullah</h3>
            <span class="leader-meta">Executive Leadership &bull; Formally Opened: 25 August 2026</span>
            <p class="leader-bio">
              "We have pledged an uncompromising struggle against narcotics, theft, and illegal scrap yards. Everything we undertake will stand firmly within the law of Pakistan, in full cooperation with our state institutions."
            </p>
          </div>
        </div>

        <!-- In-Charge Complaints Cell Card -->
        <div class="card leader-card reveal-on-scroll delay-2">
          <div class="leader-image-box">
            <img 
              src="/assets/leaders/Mr_Shafiq_ur_Rehman.webp" 
              alt="Mr. Shafiq-ur-Rehman - In-Charge Complaints Cell of Togh Aman Committee" 
              class="leader-img"
              width="400"
              height="360"
              loading="lazy"
            />
          </div>
          <div class="leader-details">
            <Badge variant="gold">In-Charge Complaints Cell</Badge>
            <h3 class="leader-name">Mr. Shafiq-ur-Rehman</h3>
            <span class="leader-meta">Complaints Cell In-Charge &bull; Direct: 0333-8303485</span>
            <p class="leader-bio">
              "If any individual faces a complaint or issue, particularly concerning any member of the Aman Committee, they are requested to contact me directly. All complaints will be heard respectfully and reviewed appropriately."
            </p>
            <div class="leader-contact-row">
              <a href="tel:03338303485" class="leader-chip-link" title="Call Mr. Shafiq-ur-Rehman">
                <Icon name="phone" size={13} />
                <span>0333-8303485</span>
              </a>
              <a href="https://wa.me/923338303485?text=Peace%20be%20upon%20you%20Mr.%20Shafiq-ur-Rehman,%20I%20have%20a%20grievance%20for%20the%20Complaints%20Cell." target="_blank" rel="noopener noreferrer" class="leader-chip-link leader-wa-chip" title="WhatsApp Complaints Cell In-Charge">
                <Icon name="whatsapp" size={13} />
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Finance Secretary Card -->
        <div class="card leader-card reveal-on-scroll delay-3">
          <div class="leader-image-box">
            <img 
              src="/assets/leaders/Waheed_ur_Rehman.webp" 
              alt="Waheed-ur-Rehman - Finance Secretary of Togh Aman Committee" 
              class="leader-img"
              width="400"
              height="360"
              loading="lazy"
            />
          </div>
          <div class="leader-details">
            <Badge variant="green">Finance Secretary</Badge>
            <h3 class="leader-name">Waheed-ur-Rehman</h3>
            <span class="leader-meta">Treasury Custodian &bull; Easypaisa: 0334 8441095</span>
            <p class="leader-bio">
              "Dedicated to 100% documented financial transparency under Chapter 8. Every community contribution is recorded with numbered receipts, and all expenses are strictly ratified for communal welfare."
            </p>
            <div class="easypaisa-badge-row">
              <span class="ep-label">Easypaisa Account:</span>
              <strong class="ep-num">0334 8441095</strong>
            </div>
            <div class="leader-contact-row">
              <a href="tel:03348441095" class="leader-chip-link" title="Call Finance Secretary">
                <Icon name="phone" size={13} />
                <span>0334 8441095</span>
              </a>
              <a href="https://wa.me/923348441095?text=Peace%20be%20upon%20you%20Waheed-ur-Rehman%20Sahib,%20I%20am%20contacting%20regarding%20Togh%20Aman%20Committee%20finance." target="_blank" rel="noopener noreferrer" class="leader-chip-link leader-wa-chip" title="WhatsApp Finance Secretary">
                <Icon name="whatsapp" size={13} />
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Latest News & Announcements -->
  <section class="section news-section" id="official-announcements">
    <div class="container">
      <div class="news-section-header reveal-on-scroll">
        <div class="news-header-titles">
          <div class="news-badge-cluster">
            <Badge variant="gold">Public Information</Badge>
            <span class="news-status-pill">
              <Icon name="shield" size={13} class="text-green" />
              <span>Official Dispatches &bull; باضابطہ نوٹیفکیشنز</span>
            </span>
          </div>
          <h2 class="news-main-heading">Official Announcements &amp; Public Notices</h2>
          <span class="news-urdu-heading urdu-text" dir="rtl">توغ امن کمیٹی کے سرکاری اعلانات اور باضابطہ نوٹیفکیشنز</span>
          <p class="news-header-desc">
            Stay informed with verified notifications, appointments, and executive communiqués issued directly by the secretariat.
          </p>
        </div>

        <div class="news-header-cta desktop-only-btn">
          <a href="/news" class="btn-archive-link">
            <span>View All Archives</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="news-grid">
        {latestNews.map((n) => (
          <NewsCard
            slug={n.id}
            title={n.data.title}
            description={n.data.description}
            pubDate={n.data.pubDate}
            category={n.data.category}
            image={n.data.image}
            pinned={n.data.pinned}
          />
        ))}
      </div>

      <div class="mobile-only-action text-center mt-6">
        <Button variant="outline" size="md" href="/news" class="w-full">
          <span>View All Announcements</span>
          <Icon name="arrow-right" size={16} />
        </Button>
      </div>
    </div>
  </section>

  <!-- 8. Get Involved / Public Action CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner card card-gold-accent reveal-on-scroll">
        <div class="cta-content">
          <Badge variant="gold">Confidential Citizen Participation</Badge>
          <h2>Have an Issue or Need Community Assistance?</h2>
          <p>
            Whether reporting narcotics activity, land encroaching on common grounds, or civic infrastructure neglect, submit your report safely. 
            Anonymous whistleblower submissions are fully supported.
          </p>
          <div class="cta-buttons">
            <Button variant="accent" size="lg" href="/complaints">
              <Icon name="alert" size={18} />
              <span>Report an Issue Now</span>
            </Button>
            <Button variant="outline" size="lg" href="/contact">
              <Icon name="phone" size={18} />
              <span>Contact Secretariat</span>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Interactive Mouse Spotlight & 3D Tilt Script -->
  <script>
    function initHeroInteractivity() {
      const heroSection = document.getElementById('hero-section');
      const interactiveCard = document.getElementById('interactive-card');

      if (!heroSection) return;

      // Check if user device has a fine pointer (desktop mouse)
      const hasFinePointer = window.matchMedia('(pointer: fine)').matches;

      if (hasFinePointer) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          // Update radial glow position
          heroSection.style.setProperty('--mouse-x', `${x}px`);
          heroSection.style.setProperty('--mouse-y', `${y}px`);

          // 3D Tilt on card
          if (interactiveCard) {
            const cardRect = interactiveCard.getBoundingClientRect();
            const cardCenterX = cardRect.left + cardRect.width / 2;
            const cardCenterY = cardRect.top + cardRect.height / 2;

            const deltaX = (e.clientX - cardCenterX) / (window.innerWidth / 2);
            const deltaY = (e.clientY - cardCenterY) / (window.innerHeight / 2);

            const rotateY = Math.max(-8, Math.min(8, deltaX * 8));
            const rotateX = Math.max(-8, Math.min(8, -deltaY * 8));

            interactiveCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          }
        });

        heroSection.addEventListener('mouseleave', () => {
          if (interactiveCard) {
            interactiveCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
          }
        });
      }
    }

    document.addEventListener('astro:page-load', initHeroInteractivity);
    initHeroInteractivity();
  </script>
</BaseLayout>

<style>
  /* Hero Redesign (World-Class 2-Column Responsive Layout) */
  .hero-section {
    position: relative;
    background: radial-gradient(circle at 50% 0%, #FFFFFF 0%, var(--color-background) 100%);
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .hero-section {
      padding-top: var(--space-16);
      padding-bottom: var(--space-24);
    }
  }

  /* Interactive Spotlight & Grid Pattern Backgrounds */
  .hero-ambient-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      650px circle at var(--mouse-x, 50%) var(--mouse-y, 30%),
      rgba(8, 116, 67, 0.12),
      rgba(212, 160, 23, 0.06) 40%,
      transparent 70%
    );
    transition: opacity 0.5s ease;
  }

  .hero-grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.55;
    background-image: radial-gradient(rgba(6, 77, 50, 0.15) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
  }

  .hero-mountain-backdrop {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 140px;
    pointer-events: none;
    z-index: 1;
  }

  .mountain-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-container-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container-grid {
      grid-template-columns: 1.25fr 0.95fr;
      gap: var(--space-10);
    }
  }

  /* Left Column Styles */
  .hero-content-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 992px) {
    .hero-content-col {
      align-items: flex-start;
      text-align: left;
    }
  }

  .hero-live-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: #FFFFFF;
    border: 1px solid rgba(8, 116, 67, 0.25);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    box-shadow: 0 2px 8px rgba(6, 77, 50, 0.06);
    margin-bottom: var(--space-4);
  }

  .live-beacon {
    position: relative;
    display: inline-flex;
    width: 10px;
    height: 10px;
  }

  .beacon-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--color-green);
  }

  .beacon-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--color-green);
    opacity: 0.75;
    animation: beacon-pulse 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beacon-pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(2.8); opacity: 0; }
  }

  .pill-text {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  .hero-main-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--color-primary);
    margin: 0 0 var(--space-4);
    letter-spacing: -0.025em;
  }

  .gold-accent-word {
    color: #b3820a;
    position: relative;
    display: inline-block;
  }

  .gold-accent-word::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    right: 0;
    height: 8px;
